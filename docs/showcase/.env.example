# Copy to ignored .env, or run scripts/init-showcase-env.py.
# This file selects the optional local demo route.
# Set Java's DeepSeek credential and configure Dify's model separately in its UI.
DEEPSEEK_API_KEY=replace-me
# Java still constructs the legacy embedding bean; this non-secret placeholder
# permits that bean to initialize. The RAGFlow route never calls this provider.
ZHIPU_API_KEY=unused-ragflow-only
TAVILY_API_KEY=

DEEPRESEARCH_RETRIEVAL_PROVIDER=ragflow
DEEPRESEARCH_RAGFLOW_INGESTION_MODE=builtin
# Java is containerized: localhost would refer to the Java container.
RAGFLOW_BASE_URL=http://host.docker.internal:9380
# For the host-side preflight only; use the same server as RAGFLOW_BASE_URL.
SHOWCASE_RAGFLOW_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=replace-me
# A NEW dataset configured with an available embedding model, not a copied ID.
RAGFLOW_DATASET_IDS=replace-me
RAGFLOW_QUERY_EXPANSION_ENABLED=false
RAGFLOW_KNN_TOP_K=32
RAGFLOW_KNN_NUM_CANDIDATES=128
RAGFLOW_RERANK_CANDIDATES_COUNT=20
RAGFLOW_SIMILARITY_THRESHOLD=0.22

# Generate FIVE different values with openssl rand -hex 32.
DEEPRESEARCH_JWT_SECRET=replace-me
DEEPRESEARCH_INTERNAL_JWT_SECRET=replace-me
DEEPRESEARCH_MCP_JWT_SECRET=replace-me
WORKFLOW_DB_PASSWORD=replace-me
DEEPRESEARCH_WORKFLOW_DIFY_TOOL_SERVICE_TOKEN=replace-me
# Copy only the TOOL_SERVICE_TOKEN value into the Dify workflow secret variable.
DEEPRESEARCH_WORKFLOW_ENABLED=true
DEEPRESEARCH_WORKFLOW_ENGINE=dify
DEEPRESEARCH_DIFY_BASE_URL=http://host.docker.internal:8081/v1
SHOWCASE_DIFY_URL=http://127.0.0.1:8081/v1
DEEPRESEARCH_DIFY_APP_KEY=replace-me

# Anonymous token issuance is for localhost demo only.
DEEPRESEARCH_DEV_TOKEN_ENABLED=true
DEEPRESEARCH_DEV_TOKEN_ALLOW_ADMIN=true
DEEPRESEARCH_APP_PORT=8080
DEEPRESEARCH_PG_PORT=5432
