# Copy to .env for local development. Never commit real values.
DEEPSEEK_API_KEY=replace-me
ZHIPU_API_KEY=replace-me
TAVILY_API_KEY=replace-me

# Run `openssl rand -hex 32` four times. Use a different result for each
# JWT secret and WORKFLOW_DB_PASSWORD. These placeholders intentionally fail
# startup so a copied example cannot silently use predictable credentials.
DEEPRESEARCH_JWT_SECRET=replace-me
DEEPRESEARCH_INTERNAL_JWT_SECRET=replace-me
DEEPRESEARCH_MCP_JWT_SECRET=replace-me

DEEPRESEARCH_WORKFLOW_ENABLED=false
WORKFLOW_MODEL_MAX_ATTEMPTS=2
WORKFLOW_MODEL_RETRY_BACKOFF_SECONDS=0.5
# Local demo only. Keep both false when tokens come from a trusted IdP/SSO.
DEEPRESEARCH_DEV_TOKEN_ENABLED=false
DEEPRESEARCH_DEV_TOKEN_ALLOW_ADMIN=false
DEEPRESEARCH_ES_PORT=9201
WORKFLOW_DB_PASSWORD=replace-me
